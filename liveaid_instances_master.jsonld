  {
    "@id": "http://wembrewind.live/ex#LiveAidWiki_Fundraising",
    "@type": [
      "http://schema.org/CreativeWork"
    ],
    "http://schema.org/about": [
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985"
      }
    ],
    "http://schema.org/citation": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid#Fundraising"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "During the concert, Bob Geldof frequently encouraged donations—reportedly prompting a dramatic surge with heartfelt appeals like “give us your money!” (though he later said he’d never uttered the phrase), leading to a pace of roughly £300 in donations every second. By the end of the event, estimates place £150 million raised overall, with some reports indicating £40–50 million collected on the day, all aimed at alleviating the Ethiopian famine."
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Live Aid — Fundraising"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid#Fundraising"
      }
    ]
