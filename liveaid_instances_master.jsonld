      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Live Aid featured one of the most ambitious international satellite television broadcasts of its time. In the UK, the BBC (in collaboration with the EBU) provided the feed, while in the US the broadcast was handled by ABC—with syndicated distribution by Orbis Communications—and MTV offering a separate stereo cable feed."
      }
    ],
