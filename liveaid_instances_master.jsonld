  {
    "@id": "http://wembrewind.live/ex#Queen_LiveAid_CareerMilestones_Resource",
    "@type": [
      "http://schema.org/CreativeWork"
    ],
    "http://schema.org/about": [
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985"
      },
      {
        "@id": "http://wembrewind.live/ex#Queen"
      }
    ],
    "http://schema.org/citation": [
      {
        "@id": "https://www.ranker.com/list/what-happened-to-queen-after-live-aid/melissa-sartore"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Queen’s Live Aid performance in 1985 revitalized their popularity and public image, leading to a surge in momentum for the band. They embarked on successful tours, most notably the Magic Tour in 1986, and released new music including the album A Kind of Magic (1986). In the years that followed, Freddie Mercury’s health began to decline due to AIDS, but the band continued to record acclaimed works such as The Miracle (1989) and Innuendo (1991). Mercury’s death in 1991 marked the end of an era, yet Queen’s legacy continued to resonate globally, cementing their status as one of the most influential rock bands in history."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "What Happened to Queen After Live Aid"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ranker.com/list/what-happened-to-queen-after-live-aid/melissa-sartore"
      }
    ]
  },
