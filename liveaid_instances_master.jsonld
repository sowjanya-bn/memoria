    "http://schema.org/startDate": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "1985-07-13"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "http://wembrewind.live/ex#ConcertPhiladelphia1985"
      },
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985_Philadelphia"
      },
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985_Wembley"
      }
    ],
    "http://wembrewind.live/ex#hadBroadcast": [
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985Broadcast"
      }
    ],
    "http://wembrewind.live/ex#hasChallenge": [
      {
        "@language": "en",
        "@value": "Bands performed without sound checks, leading to problems like U2 nearly pulling out and Paul McCartney starting with no sound in the stadium."
      },
      {
        "@language": "en",
        "@value": "Criticism from The Voice for allegedly excluding black British artists; several prominent black American artists declined to participate."
      },
      {
        "@language": "en",
        "@value": "Dire Straits had to rush from Live Aid to a separate concert at Wembley Arena on the same day."
      },
      {
        "@language": "en",
        "@value": "During the Moscow broadcast, audio played correctly but visuals initially showed a cherry harvest documentary instead of the band Autograph."
      },
      {
        "@language": "en",
        "@value": "Phil Collins performed at both Wembley and Philadelphia using the Concorde, but faced technical and performance issues with Led Zeppelin."
      },
      {
        "@language": "en",
        "@value": "Some artists, including Queen, were announced as confirmed before they had agreed to perform."
      },
      {
        "@language": "en",
        "@value": "The concert was organised in just 12 weeks."
      }
    ],
