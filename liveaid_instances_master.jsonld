  {
    "@id": "http://wembrewind.live/ex#LiveAidWiki_Organisation",
    "@type": [
      "http://schema.org/CreativeWork"
    ],
    "http://schema.org/about": [
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985"
      }
    ],
    "http://schema.org/citation": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid#Organisation"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The concert was organized by Bob Geldof—who spearheaded the project—and Midge Ure, with promoter Harvey Goldsmith overseeing the London (Wembley) leg and Michael C. Mitchell managing the U.S. (Philadelphia) component. Tony Verna and Hal Uplinger handled the technical and broadcast logistics, designing the satellite feed, securing the JFK Stadium venue, and coordinating the U.S. prime-time broadcast arrangements."
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid"
      }
    ],
