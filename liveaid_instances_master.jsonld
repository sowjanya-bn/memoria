  {
    "@id": "http://wembrewind.live/ex#LiveAidWiki_Background",
    "@type": [
      "http://schema.org/CreativeWork"
    ],
    "http://schema.org/about": [
      {
        "@id": "http://wembrewind.live/ex#LiveAid1985"
      }
    ],
    "http://schema.org/citation": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid#Background"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Live Aid was a dual-venue global benefit concert held on 13 July 1985, inspired by the Band Aid charity single “Do They Know It’s Christmas?” to raise funds for famine relief in Ethiopia. Conceived by Bob Geldof and Midge Ure, it was broadcast to nearly 2 billion viewers worldwide and became a landmark in humanitarian fundraising and popular culture."
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Live Aid — Background"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://en.wikipedia.org/wiki/Live_Aid#Background"
      }
    ]
  },
